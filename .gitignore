# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# ============================================================
#  依赖
# ============================================================
node_modules/

# ============================================================
#  Expo / Metro 产物
# ============================================================
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# ============================================================
#  原生工程
#  android/ 里有手工维护的签名配置、权限调整（tools:node="remove"）、
#  图标原生资源与单架构设定，必须入库 —— 否则重新 prebuild 会冲掉。
#  这里只忽略构建产物与机器相关的本地文件。
# ============================================================
/ios
/android/build/
/android/app/build/
/android/app/.cxx/
/android/app/release/
/android/.gradle/
/android/.kotlin/
/android/local.properties

# ============================================================
#  凭据与密钥 —— 严禁入库
# ============================================================
*.jks
*.keystore
key.properties
*.p8
*.p12
*.key
*.pem
*.mobileprovision

# ============================================================
#  本地构建脚本与日志（本机构建用，不入库）
# ============================================================
/_build/
# 构建期临时目录：日志重定向、预热下来的 bundle、进程清单等
/.workbuddy/
# 仓库根目录下以 _ 开头的文件都是勘探期临时产物（日志、探测脚本、
# 拿来差分的基线 APK —— 动辄 48MB×N）。留着会拖慢每次 clone。
# 要留档就移进 _build/scratch/，别放根目录。
/_*

# ============================================================
#  本地环境变量
# ============================================================
.env
.env.*
!.env.example

# ============================================================
#  编辑器 / 系统垃圾
# ============================================================
.DS_Store
Thumbs.db
*.orig.*
*.tsbuildinfo
npm-debug.*
yarn-debug.*
yarn-error.*
