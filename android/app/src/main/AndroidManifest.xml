<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" tools:replace="android:maxSdkVersion"/>
  <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" tools:node="remove"/>
  <!-- ★★ 角标（badge）这一族 16 条，全部来自 expo-notifications 的传递依赖
       `me.leolin:ShortcutBadger:1.1.22`（它会往合并清单里塞 20 条，AGP 滤掉 4 条、
       实际进来 16 条：华为 / 三星 / OPPO / 索尼 / HTC / 各色第三方启动器）。
       格物**从不写角标**（`setNotificationHandler` 里 `shouldSetBadge: false`，
       渠道的 `showBadge` 是系统自己的小圆点，不走 ShortcutBadger），
       所以它们是纯噪声：用户看不见，但一份「权限清单」里多出 16 条第三方启动器权限，
       与「数据不出手机、权限最小」的定位自相矛盾。
       ★ 判据＝两版 APK 的 `aapt2 dump badging` 权限**计数差**：加通知这一版
         从 7 条涨到 28 条，预期只该多 2 条（POST_NOTIFICATIONS + 开机自恢复）。
       ★ 只删这一个族；`WAKE_LOCK` / `c2dm.RECEIVE` / `BIND_GET_INSTALL_REFERRER_SERVICE`
         留着 —— 它们来自 firebase-messaging，删了有把通知链路弄坏的风险，
         而这三条都不弹权限框、对用户不可见。 -->
  <uses-permission android:name="android.permission.READ_APP_BADGE" tools:node="remove"/>
  <uses-permission android:name="com.anddoes.launcher.permission.UPDATE_COUNT" tools:node="remove"/>
  <uses-permission android:name="com.htc.launcher.permission.READ_SETTINGS" tools:node="remove"/>
  <uses-permission android:name="com.htc.launcher.permission.UPDATE_SHORTCUT" tools:node="remove"/>
  <uses-permission android:name="com.huawei.android.launcher.permission.CHANGE_BADGE" tools:node="remove"/>
  <uses-permission android:name="com.huawei.android.launcher.permission.READ_SETTINGS" tools:node="remove"/>
  <uses-permission android:name="com.huawei.android.launcher.permission.WRITE_SETTINGS" tools:node="remove"/>
  <uses-permission android:name="com.majeur.launcher.permission.UPDATE_BADGE" tools:node="remove"/>
  <uses-permission android:name="com.oppo.launcher.permission.READ_SETTINGS" tools:node="remove"/>
  <uses-permission android:name="com.oppo.launcher.permission.WRITE_SETTINGS" tools:node="remove"/>
  <uses-permission android:name="com.sec.android.provider.badge.permission.READ" tools:node="remove"/>
  <uses-permission android:name="com.sec.android.provider.badge.permission.WRITE" tools:node="remove"/>
  <uses-permission android:name="com.sonyericsson.home.permission.BROADCAST_BADGE" tools:node="remove"/>
  <uses-permission android:name="com.sonymobile.home.permission.PROVIDER_INSERT_BADGE" tools:node="remove"/>
  <uses-permission android:name="me.everything.badger.permission.BADGE_COUNT_READ" tools:node="remove"/>
  <uses-permission android:name="me.everything.badger.permission.BADGE_COUNT_WRITE" tools:node="remove"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" tools:replace="android:maxSdkVersion"/>
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
  </queries>
  <application android:name=".MainApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="true" android:theme="@style/AppTheme" android:supportsRtl="true" android:enableOnBackInvokedCallback="false">
    <meta-data android:name="expo.modules.updates.ENABLED" android:value="false"/>
    <meta-data android:name="expo.modules.updates.ENABLE_BSDIFF_PATCH_SUPPORT" android:value="true"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0"/>
    <!-- 到期提醒的通知栏图标。
         ★ 这两条本来是 expo-notifications 的配置插件在 prebuild 时写的；
           本项目**不跑 prebuild**（android/ 里有手工改动：tools:node="remove" 那几条、
           enableOnBackInvokedCallback、launchMode 等），所以按插件源码逐条手写在这里。
           图标是 96×96 的**纯白 + 透明** PNG（Alpha 当蒙版，系统会用下面的颜色着色），
           五档密度在 res/drawable-*/notification_icon.png。
           ★ 只加图标与颜色，**不加任何权限** —— POST_NOTIFICATIONS 与开机自恢复的 receiver
             由 expo-notifications 库自带的清单经 Gradle 合并进来，不需要在这里写。 -->
    <meta-data android:name="expo.modules.notifications.default_notification_icon" android:resource="@drawable/notification_icon"/>
    <meta-data android:name="expo.modules.notifications.default_notification_color" android:resource="@color/notification_icon_color"/>
    <activity android:name=".MainActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|smallestScreenSize|assetsPaths" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.App.SplashScreen" android:exported="true" android:screenOrientation="portrait">
      <!-- 长按图标的静态快捷方式（三条：录一件 / 待办 / 找东西）。
           ★ 标签必须写在 res/values/strings.xml 里，不能内联 —— 否则编译失败。
           ★★ 这份 XML 解析不过时 Android 会**静默跳过整份文件**：长按菜单里
              一条都不出现，不报错、不崩溃、日志里也未必有痕迹。唯一真相是
                  adb shell cmd shortcut get-shortcuts com.gewu.app
              （改完还要重启 Launcher 才看得到，别把系统缓存当成「没生效」。
                ★ 注意：**没有** list-shortcuts / invoke-shortcut 这两个子命令，
                而且它打印 intent 时会连 path 与 query 一起省略掉，
                所以它证明不了 `?focus=search` 有没有被认 —— 详见过那里的说明。）
           ★ 三条都走 deep link（intent 的 android:data）而不是原生 extra：
             MainActivity 上已经有下面那个 `gewu` scheme 的 intent-filter，
             expo-linking 会接住 URI、expo-router 负责路由 —— 不需要一行 Kotlin。
             桌面小组件的点击跳转复用同一条通路（见 widget/GewuWidgetProvider.kt）。 -->
      <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts"/>
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="gewu"/>
      </intent-filter>
    </activity>
    <!-- ============================================================
         桌面小组件（方案甲 · 待办看板）

         ★★ `exported="false"` 是对的，别改成 true：
            APPWIDGET_UPDATE 是**系统**（system_server，uid 1000）发的，
            而系统在 `ActivityManager.checkComponentPermission` 里是被直接放行的
            ——所以不需要（也不应该）把自己暴露出去。
         ★ 但它同时也是**最值得怀疑的一处**：万一这个判断有误，
            表现是 onUpdate 永不触发 —— widget 停在 initialLayout（一张空白卡片），
            不报错、不崩溃。排查顺序：
              ① adb logcat -s GewuWidget  —— 有没有「渲染 …」那一行
              ② adb shell dumpsys appwidget | grep -A5 gewu  —— provider 注册上没有
              ③ 真到这一步再把 exported 改成 true 试一次，并记下来为什么。
         ★ 这里**不加任何权限**：widget 不需要权限，读自己的私有目录也不需要。
            出包后照例做双版本差分的权限计数（见 docs/roadmap.md 的校验链）。 -->
    <receiver
        android:name=".widget.GewuWidgetProvider"
        android:exported="false">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/gewu_widget_info"/>
    </receiver>
  </application>
</manifest>